# ---------------------------------------------------------------------------
# Base de données des tests automatisés.
#
# Les tests d'intégration vident les tables de contenu avant chaque scénario
# (`resetDatabase()`). Ils visent donc une base DÉDIÉE, distincte de celle du
# développement : lancer `npm test` ne doit jamais détruire le contenu de
# démonstration.
#
# Création de la base (une seule fois) :
#   npm run test:setup
# ---------------------------------------------------------------------------

DATABASE_URL=postgresql://exam:exam@localhost:5434/exam_prep_test?schema=public
NODE_ENV=test
