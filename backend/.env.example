# ---------------------------------------------------------------------------
# API — configuration locale
# Copiez ce fichier en « .env » à la racine de « backend/ ».
# ---------------------------------------------------------------------------
NODE_ENV=development
PORT=4100

# Chaîne de connexion Prisma.
# Le port 5434 correspond au POSTGRES_PORT du fichier .env à la racine.
DATABASE_URL=postgresql://exam:exam@localhost:5434/exam_prep?schema=public

# Origines autorisées pour CORS (séparées par des virgules).
CORS_ORIGIN=http://localhost:5173
