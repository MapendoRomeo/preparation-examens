# ---------------------------------------------------------------------------
# Base de données
# ---------------------------------------------------------------------------
POSTGRES_USER=exam
POSTGRES_PASSWORD=exam
POSTGRES_DB=exam_prep
POSTGRES_PORT=5432

# Chaîne de connexion utilisée par Prisma (backend lancé sur l'hôte)
DATABASE_URL=postgresql://exam:exam@localhost:5432/exam_prep?schema=public

# Même chaîne, mais vue depuis le conteneur backend (hôte = nom du service)
DATABASE_URL_DOCKER=postgresql://exam:exam@db:5432/exam_prep?schema=public

# ---------------------------------------------------------------------------
# Backend
# ---------------------------------------------------------------------------
NODE_ENV=development
BACKEND_PORT=4100
# Origines autorisées pour CORS (séparées par des virgules)
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------------
# Frontend (Vite)
# ---------------------------------------------------------------------------
# URL de l'API consommée par le navigateur
VITE_API_URL=http://localhost:4100/api
FRONTEND_PORT=5173
